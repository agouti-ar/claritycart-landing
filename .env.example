PORT=3000
GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
ADMIN_EMAILS=darksteel180@gmail.com,lordlymonk@gmail.com

# Separate server-only HMAC secret; at least 32 random characters. Never embed in storefront code.
WIDGET_SESSION_SECRET=replace_with_a_server_only_random_secret_of_at_least_32_characters

# Stage 5: server-only Paddle Billing. Keep Sandbox and Production credentials separate.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=https://your-approved-domain.example/billing
# Regular recurring prices: no trial. Separate trial prices: free, card-required, exactly 7 days.
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_MONTHLY_TRIAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_MONTHLY_TRIAL=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_MONTHLY_TRIAL=
# Optional until annual checkout is enabled/configured:
# PADDLE_PRICE_STARTER_YEARLY=
# PADDLE_PRICE_STARTER_YEARLY_TRIAL=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_PRO_YEARLY_TRIAL=
# PADDLE_PRICE_BUSINESS_YEARLY=
